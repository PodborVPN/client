{
    "log": {
        "loglevel": "info",
        "access": "/tmp/access.log"
    },
    "env": {
        "xray.location.asset": "/assets",
        "xray.tun.fd": "42"
    },
    "api": {
        "tag": "api",
        "services": [
            "RoutingService",
            "StatsService"
        ]
    },
    "stats": {},
    "policy": {
        "system": {
            "statsInboundUplink": true,
            "statsInboundDownlink": true,
            "statsOutboundUplink": true,
            "statsOutboundDownlink": true
        }
    },
    "dns": {
        "servers": [
            {
                "address": "77.88.8.8",
                "domains": [
                    "geosite:category-ru"
                ]
            },
            {
                "address": "1.1.1.1"
            }
        ]
    },
    "inbounds": [
        {
            "tag": "api",
            "protocol": "dokodemo-door",
            "listen": "/tmp/xray-api.sock",
            "settings": {
                "address": "127.0.0.1"
            }
        },
        {
            "tag": "in.s001",
            "protocol": "socks",
            "listen": "127.0.0.1",
            "port": 20000,
            "settings": {
                "udp": false,
                "auth": "password",
                "accounts": [
                    {
                        "user": "u",
                        "pass": "p"
                    }
                ]
            }
        },
        {
            "tag": "in.s002",
            "protocol": "socks",
            "listen": "127.0.0.1",
            "port": 20001,
            "settings": {
                "udp": false,
                "auth": "password",
                "accounts": [
                    {
                        "user": "u",
                        "pass": "p"
                    }
                ]
            }
        },
        {
            "tag": "in.s003",
            "protocol": "socks",
            "listen": "127.0.0.1",
            "port": 20002,
            "settings": {
                "udp": false,
                "auth": "password",
                "accounts": [
                    {
                        "user": "u",
                        "pass": "p"
                    }
                ]
            }
        },
        {
            "tag": "tun",
            "protocol": "tun",
            "settings": {
                "name": "podbor0",
                "mtu": 1500
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ],
                "routeOnly": true
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "vless",
            "tag": "s001"
        },
        {
            "protocol": "vless",
            "tag": "s002"
        },
        {
            "protocol": "vless",
            "tag": "s003"
        },
        {
            "protocol": "vless",
            "tag": "pair.insta.s001"
        },
        {
            "protocol": "vless",
            "tag": "pair.tg.s001"
        },
        {
            "protocol": "vless",
            "tag": "pair.insta.s002"
        },
        {
            "protocol": "vless",
            "tag": "pair.tg.s002"
        },
        {
            "protocol": "vless",
            "tag": "pair.insta.s003"
        },
        {
            "protocol": "vless",
            "tag": "pair.tg.s003"
        },
        {
            "tag": "direct",
            "protocol": "freedom"
        },
        {
            "tag": "block",
            "protocol": "blackhole"
        },
        {
            "tag": "dns-out",
            "protocol": "dns"
        }
    ],
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {
                "inboundTag": [
                    "api"
                ],
                "outboundTag": "api"
            },
            {
                "inboundTag": [
                    "in.s001"
                ],
                "outboundTag": "s001"
            },
            {
                "inboundTag": [
                    "in.s002"
                ],
                "outboundTag": "s002"
            },
            {
                "inboundTag": [
                    "in.s003"
                ],
                "outboundTag": "s003"
            },
            {
                "inboundTag": [
                    "tun"
                ],
                "port": 53,
                "outboundTag": "dns-out"
            },
            {
                "domain": [
                    "geosite:category-ru"
                ],
                "outboundTag": "direct"
            },
            {
                "ip": [
                    "geoip:ru"
                ],
                "outboundTag": "direct"
            },
            {
                "ruleTag": "svc.insta.domain",
                "domain": [
                    "geosite:facebook",
                    "geosite:instagram"
                ],
                "balancerTag": "svc.insta"
            },
            {
                "ruleTag": "svc.tg.domain",
                "domain": [
                    "geosite:telegram"
                ],
                "balancerTag": "svc.tg"
            },
            {
                "ruleTag": "svc.insta.ip",
                "ip": [
                    "geoip:facebook"
                ],
                "balancerTag": "svc.insta"
            },
            {
                "ruleTag": "svc.tg.ip",
                "ip": [
                    "geoip:telegram"
                ],
                "balancerTag": "svc.tg"
            },
            {
                "ruleTag": "svc.tg.app",
                "process": [
                    "10304"
                ],
                "balancerTag": "svc.tg"
            },
            {
                "network": "tcp,udp",
                "balancerTag": "exit"
            }
        ],
        "balancers": [
            {
                "tag": "exit",
                "selector": [
                    "s001",
                    "s002",
                    "s003"
                ]
            },
            {
                "tag": "svc.insta",
                "selector": [
                    "pair.insta.s001",
                    "pair.insta.s002",
                    "pair.insta.s003"
                ]
            },
            {
                "tag": "svc.tg",
                "selector": [
                    "pair.tg.s001",
                    "pair.tg.s002",
                    "pair.tg.s003"
                ]
            }
        ]
    }
}
